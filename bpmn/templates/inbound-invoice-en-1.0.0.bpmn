          <imixs:value><![CDATA[var result={};
 var refField="txtcomment"; 
result.isValid=true;

 if (  ( workitem.get(refField) == null || ''==workitem.get(refField)[0])   ) {
     result.isValid=false;
     result.errorMessage='Please enter a comment.';
  }]]></imixs:value>
        </imixs:item>
