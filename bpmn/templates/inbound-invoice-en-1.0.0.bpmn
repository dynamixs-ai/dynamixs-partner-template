    <bpmn2:dataObject id="DataObject_2" imixs:datatype="form-data" name="Invoice Form">
      <bpmn2:documentation id="Documentation_8"><![CDATA[<?xml version="1.0"?>
<imixs-form>
  <imixs-form-section columns="3"  readonly="true" label="Dokument Info:" >
    <item name="document.reference" type="text" label="Referenz: "  />
    <item name="document.country" type="text" label="Land: "  />
    <item name="document.language" type="text" label="Language: "  />
    <item name="document.company" type="text" label="Firma: "  span="8" />
    <item name="document.sender" type="text" label="E-Mail: "  span="4"  />
  </imixs-form-section>

  <imixs-form-section columns="1" label="Invoice Details">
    <item name="cdtr.name" type="text"  label="Creditor:" />
  </imixs-form-section>
  <imixs-form-section columns="2">
    <item name="invoice.number" type="text"  label="Invoice-No.:" />
    <item name="invoice.date" type="date"  label="Invoice Date:" />
    <item name="invoice.total" type="currency"  label="Invoice Total:" />
    <item name="payment.type" type="text"  label="Payment Type:" />
    <item name="cdtr.iban" type="text"  label="IBAN:" />
    <item name="cdtr.bic" type="text"  label="BIC:" />
  </imixs-form-section>
 
  <imixs-form-section columns="1">
 <item name="invoice.summary" type="custom" path="markdown" readonly="true" label="Summary" />
  </imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
      <bpmn2:dataState id="DataState_1"/>
    </bpmn2:dataObject>
