    <bpmn2:dataObject id="dataObject_ayzU0w" imixs:datatype="form-data" name="Invoice Form">
      <bpmn2:documentation id="Documentation_8"><![CDATA[<?xml version="1.0"?>
<imixs-form>
  <imixs-form-section label="KI Assistent:" path="ai/agent_status" />
  <imixs-form-section columns="1" label="Invoice Details">
    <item name="cdtr.name" type="text"  label="Creditor:" />
  </imixs-form-section>
  <imixs-form-section columns="2">
    <item name="invoice.number" type="text"  label="Invoice-No.:" />
