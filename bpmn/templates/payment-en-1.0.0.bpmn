          <imixs:value><![CDATA[1]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_DFkPAQ"><![CDATA[Payment Validation Check is failed. That means provide data is not matching. It could be reference number stated doesn't match or Bank details like name, IBAN, BIC are not matching or given customer details are not matching.]]></bpmn2:documentation>
      <bpmn2:incoming>sequenceFlow_asZ0wQ</bpmn2:incoming>
      <bpmn2:outgoing>sequenceFlow_a03x4g</bpmn2:outgoing>
