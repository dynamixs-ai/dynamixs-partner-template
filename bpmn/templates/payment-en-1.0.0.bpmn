    <bpmn2:intermediateCatchEvent id="event_b740TQ" imixs:activityid="100" name="Repayment request">
      <bpmn2:extensionElements>
        <imixs:item name="rtfresultlog" type="xs:string">
          <imixs:value><![CDATA[Data Mismatch is detected in validation check.]]></imixs:value>
        </imixs:item>
        <imixs:item name="nammailreceiver" type="xs:string">
