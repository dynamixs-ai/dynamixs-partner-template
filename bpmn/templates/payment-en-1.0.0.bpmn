    <bpmn2:dataObject id="dataObject_fV6H2w" imixs:datatype="form-data" name="Payment Data">
      <bpmn2:documentation id="documentation_gnvAHg"><![CDATA[<?xml version="1.0"?>
<imixs-form>
<imixs-form-section columns="3">   
      <item name="finemanagement.ref"
        type="custom"
        path="workitemlink"
        readonly="false"
        options="$workflowgroup:finemanagement"
        label="Payment Category" />
      
     
     <item name="fine.category.name" type="text" label="Violation Category:" />
      <item name="fine.id"    type="text"  label="Fine ID:" />
      <item name="contract.customer.firstname" type="text"  label="Firstname:" />
      <item name="contract.customer.lastname"  type="text"  label="Lastname:" />
      <item name="contract.customer.email"  type="text"    label="Email:"  />
      <item name="payment.bank.name" type="text" label="Bank Name:" />
      <item name="payment.account.number" type="text" label="Account Number" />
      <item name="payment.reference" type="text" label="Payment Reference:" />
      <item name="payment.type" type="selectOneMenu"     label="Payment Type:" 
       options = "EC; VISA; PayPal" required="false"/>
      <item name="payment.amount" type="currency" label="Amount:" />
      <item name="payment.currency" type="selectOneMenu"
            label="Currency:"
            options="EUR;CHF;SEK;NOK;GBP;USD" />
      <item name="payment.dbtr.iban" type="iban" label="IBAN" />
      <item name="payment.dbtr.bic" type="bic" label="BIC/SWIFT" /> 
</imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
