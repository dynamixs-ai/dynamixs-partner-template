    <bpmn2:dataObject id="dataObject_fV6H2w" imixs:datatype="form-data" name="Payment Data">
      <bpmn2:documentation id="documentation_gnvAHg"><![CDATA[<?xml version="1.0"?>
<imixs-form>
<imixs-form-section label="Payment details: " columns="2">
     <item name="payment.type" type="selectOneMenu"     label="Payment Type:" 
       options = "EC; VISA; PayPal" required="false"/>
      <item name="payment.id"    type="text"  label="Paymnet ID:" />
      <item name="payment.customer.firstname" type="text"  label="Firstname:" />
      <item name="payment.customer.lastname"  type="text"  label="Lastname:" />
      <item name="payment.customer.email"  type="text"    label="Email:"  />
</imixs-form-section>

<imixs-form-section label="Payment details:" >
     <item name="payment.customer.zip" type="text"     label="ZIP:" />
     <item name="payment.customer.city" type="text"     label="City:" />
     <item name="payment.customer.country" type="custom"  path="country"  label="Membership Country:" />
     <item name="payment.currency" type="selectOneMenu"
            label="Currency:"
            options="EUR;CHF;SEK;NOK;GBP;USD" />
        <item name="payment.posting.date" type="text" label="Posting date: " />
        <item name="payment.value.date" type="text" label="Value date:" />
        <item name="payment.transaction.date" type="date" label="Transaction date:" />     
        <item name="payment.bank.name" type="text" label="Bank Name: " />
        <item name="payment.reference.number" type="text" label="Paymnet Reference: " />
        <item name="payment.dbtr.iban" type="iban" label="IBAN" />
        <item name="payment.dbtr.bic" type="bic" label="BIC/SWIFT" />
     
</imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
