        </imixs:item>
        <imixs:item name="rtfmailbody" type="xs:string">
          <imixs:value><![CDATA[Hallo, 

thanks for contacting us. We cant go forward with your payment due to missmatch in data. Hence we request you to please recheck the provided data and redo the payment. 











]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtmailsubject" type="xs:string">
          <imixs:value><![CDATA[Automatic reply]]></imixs:value>
        </imixs:item>
