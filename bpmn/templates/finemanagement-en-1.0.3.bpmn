    <bpmn2:intermediateCatchEvent id="event_sc12QA" imixs:activityid="150" name="Rental">
      <bpmn2:extensionElements>
        <imixs:item name="keypublicresult" type="xs:string">
          <imixs:value><![CDATA[1]]></imixs:value>
        </imixs:item>
        <imixs:item name="rtfresultlog" type="xs:string">
          <imixs:value><![CDATA[Its is Rental vehicle.]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtmailsubject" type="xs:string">
          <imixs:value><![CDATA[Traffic Fine management to <itemvalue>plate.number</itemvalue>]]></imixs:value>
        </imixs:item>
        <imixs:item name="nammailreceiver" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceivercc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceiverbcc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="rtfmailbody" type="xs:string">
          <imixs:value><![CDATA[Dear Gabi,

This email serves as an official notification of a traffic violation detected on <itemvalue>fine.violation.date</itemvalue>.Our systems recorded your vehicle at <itemvalue>fine.location.country</itemvalue> ;<itemvalue>fine.vioalition.location</itemvalue> Location of Violation committing the following offense: <itemvalue>fine.category.name</itemvalue>.Violation SummaryNotice for Vehicle Plate:<itemvalue>plate.number</itemvalue> Fine Amount: <itemvalue>fine.amount</itemvalue> Due Date: <itemvalue>payment.duedate</itemvalue> from receipt.



Best regards.
]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtactivityresult" type="xs:string">
          <imixs:value><![CDATA[<workitemlink name="copydata">
	<ref>contract.ref</ref>
	  <items>(^customer\.)|(^contract\.)|(^plate\.)</items>
      <debug>false</debug>
</workitemlink>
<itemsvalue>fine.category.name</itemvalue>
<itemsvalue>fine.violation.date</itemvalue>
<itemsvalue>fine.location.description</itemvalue>]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
