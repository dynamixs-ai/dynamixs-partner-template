    <bpmn2:task id="task_k0bZhg" imixs:processid="1920" name="Close the case">
      <bpmn2:extensionElements>
        <imixs:item name="txtworkflowsummary" type="xs:string">
          <imixs:value><![CDATA[<itemvalue>fine.id</itemvalue>  <itemvalue>fine.category.name</itemvalue><itemvalue>fine.plate.number</itemvalue>]]></imixs:value>
        </imixs:item>
