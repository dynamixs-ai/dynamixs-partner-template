    <bpmn2:intermediateCatchEvent id="event_JL8vrA" imixs:activityid="250" name="Email to Owner">
      <bpmn2:extensionElements>
        <imixs:item name="keypublicresult" type="xs:string">
          <imixs:value><![CDATA[1]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtmailsubject" type="xs:string">
          <imixs:value><![CDATA[<itemvalue>fine.id</itemvalue> <itemvalue>fine.category.name</itemvalue> correction]]></imixs:value>
        </imixs:item>
        <imixs:item name="nammailreceiver" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceivercc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceiverbcc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="rtfmailbody" type="xs:string">
          <imixs:value><![CDATA[Hallo,

your payment was not sucessful. There is mismatch in the data provided. Please check details and correct them and redo the transaction. Please do transaction before Due date to avoid additional charges.


Best regards.
]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_1vwn4Q"><![CDATA[An Email has been sent to vehicle owner to check the transactions details and to repeat transaction.]]></bpmn2:documentation>
      <bpmn2:incoming>sequenceFlow_XgpFoQ</bpmn2:incoming>
      <bpmn2:outgoing>sequenceFlow_cmGnag</bpmn2:outgoing>
      <bpmn2:messageEventDefinition id="messageEventDefinition_nvEzog" messageRef="message_1"/>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:task id="task_d9Blfg" imixs:processid="1930" name="Payment inclomplete">
      <bpmn2:extensionElements>
        <imixs:item name="txtworkflowsummary" type="xs:string">
          <imixs:value><![CDATA[<itemvalue>fine.id</itemvalue>  <itemvalue>fine.category.name</itemvalue><itemvalue>fine.plate.number</itemvalue>]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_AoinkA"><![CDATA[Payment is not sucessful and the case is still open. The status is updated as failed transaction.]]></bpmn2:documentation>
      <bpmn2:incoming>sequenceFlow_cmGnag</bpmn2:incoming>
      <bpmn2:outgoing>sequenceFlow_4QJC0w</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:intermediateCatchEvent id="event_Ldvexw" imixs:activityid="180" name="[create payment]">
      <bpmn2:extensionElements>
        <imixs:item name="rtfresultlog" type="xs:string">
          <imixs:value><![CDATA[Payment is created and forwarded to driver and waiting for payment.]]></imixs:value>
        </imixs:item>
        <imixs:item name="keypublicresult" type="xs:string">
          <imixs:value><![CDATA[0]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtactivityresult" type="xs:string">
          <imixs:value><![CDATA[<split name="subprocess_create">
  <modelversion>payment-en-1.0</modelversion>
  <task>100</task>
  <event>100</event>
  <items>(^customer),(^contract),(^fine),(^payment)</items>
  <action>/pages/workitems/workitem.jsf?id=<itemvalue>$uniqueid</itemvalue></action>
  <debug>true</debug>
</split>]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_k0uVTQ"><![CDATA[Payment is created ]]></bpmn2:documentation>
      <bpmn2:incoming>sequenceFlow_k1tb2w</bpmn2:incoming>
      <bpmn2:outgoing>sequenceFlow_Zo9IOw</bpmn2:outgoing>
      <bpmn2:outgoing>association_NQKovg</bpmn2:outgoing>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:intermediateCatchEvent id="event_RnD1Ig" imixs:activityid="210" name="[payment received]">
      <bpmn2:extensionElements>
        <imixs:item name="keypublicresult" type="xs:string">
          <imixs:value><![CDATA[0]]></imixs:value>
        </imixs:item>
        <imixs:item name="rtfresultlog" type="xs:string">
          <imixs:value><![CDATA[Driver accepts violation and is ready to pay fine.]]></imixs:value>
        </imixs:item>
