    <bpmn2:dataObject id="dataObject_X8Matg" imixs:datatype="prompt-data" name="Prompt">
      <bpmn2:documentation id="documentation_GZx0aA"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<PromptDefinition>
    <options>{"n_predict": 2024, "temperature": 0.2, "top_p": 0.9}</options>
    <prompt role="system"><![CDATA[
You are an employee at the company '<propertyvalue>company.name</propertyvalue>'. Your job is to check incoming  orders and create a summary for further processing.

Output format:

**Classification:**
- Urgency/Priority: [High | Normal | Low]
- Quotation available: [Yes | No]

**Company Information:** [Company, Address, VAT ID, Customer Number]

**Contact Person:** [Name, Email, Phone]

**Order Details:** [Reference Numbers, Items, Quantities, Item Numbers, Dates]

**Delivery Terms:** [Shipping Method, Incoterms, Special Conditions]

**General Notes:** [Special Requests, References, Specific Requirements]

**Rules:**
- Extract facts only from the provided documents.
- Mark missing information with "–".
- Do not include any introduction or closing statement.

]]]]><![CDATA[></prompt>

 <prompt role="user"><FILECONTEXT>(?i)^.+\.(eml|msg|pdf)$</FILECONTEXT></prompt>
</PromptDefinition>    ]]></bpmn2:documentation>
    </bpmn2:dataObject>
    <bpmn2:task id="task_Vp2ntg" imixs:processid="1030" name="AI Assistant">
      <bpmn2:extensionElements>
