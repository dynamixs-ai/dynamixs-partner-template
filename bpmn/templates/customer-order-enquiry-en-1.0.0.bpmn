    <bpmn2:intermediateCatchEvent id="intermediateCatchEvent_hHdnlA" imixs:activityid="170" name="Start">
      <bpmn2:extensionElements>
        <imixs:item name="rtfresultlog" type="xs:string">
          <imixs:value>AI extracts data.</imixs:value>
        </imixs:item>
        <imixs:item name="txtactivityresult" type="xs:string">
          <imixs:value><![CDATA[<validation name="required">false</validation>
<item name="bpmn.agent.user.input"></item>
<eventlog name="ai.agent.process">
    <ref><itemvalue>$uniqueid</itemvalue></ref>
    <document>
        <agent.context.item>agent.context.order</agent.context.item>
        <agent.user.item>bpmn.agent.user.input</agent.user.item>
        <agent.endpoint>api.llama.cpp.imixs.com</agent.endpoint>
        <agent.timeout>120000</agent.timeout>
        <agent.max-iterations>10</agent.max-iterations>
        <agent.event.next>240</agent.event.next>
        <agent.event.success>200</agent.event.success>
        <agent.event.error>300</agent.event.error>
 
        <agent.debug>true</agent.debug>
    </document>
</eventlog>]]></imixs:value>
        </imixs:item>
        <imixs:item name="keypublicresult" type="xs:string">
          <imixs:value><![CDATA[1]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_jF1GNw">AI extracts data which is scanned.</bpmn2:documentation>
      <bpmn2:incoming>sequenceFlow_dNrXgQ</bpmn2:incoming>
