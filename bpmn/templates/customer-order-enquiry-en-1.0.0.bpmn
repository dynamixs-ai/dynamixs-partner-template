        </imixs:item>
        <imixs:item name="txtworkflowabstract" type="xs:string">
          <imixs:value>Fine Details:
Fine Id : &lt;itemvalue&gt;fine.id&lt;/itemvalue&gt;

Vehicle Details:
Vehicle Plate Number :&lt;itemvalue&gt;fine.plate.number&lt;/itemvalue&gt;,
