    <bpmn2:intermediateCatchEvent id="event_72CA2w" imixs:activityid="50" name="Not available">
      <bpmn2:extensionElements>
        <imixs:item name="rtfresultlog" type="xs:string">
          <imixs:value><![CDATA[Request is rejected because of not availabilty of the Product]]></imixs:value>
