    <bpmn2:dataObject id="dataObject_h50JiA" imixs:datatype="prompt-data" name="Super Agent">
      <bpmn2:documentation id="documentation_0idvzQ"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<PromptDefinition> 
  <options>{"n_predict": 4096, "temperature": 0 }</options>
  <tools>update_workitem,link_workitem,task_complete</tools>
  <prompt role="system"><![CDATA[
You are an employee at the company '<propertyvalue>company.name</propertyvalue>'. Your job is to check incoming orders and extract data for further processing.

<bpmn.form root="order" readonly="ignore" />


Call 'update_workitem' to update the workitem fields. 

Only include fields in the update_workitem call for which you actually found data in the
order. Leave out any field you cannot determine with reasonable confidence - do not guess.


Respond with call task_complete.
]]]]><![CDATA[>
</prompt>
<prompt role="user"><itemvalue>order.summary</itemvalue></prompt>
</PromptDefinition>]]></bpmn2:documentation>
    </bpmn2:dataObject>
