    <bpmn2:dataObject id="dataObject_jGwopw" imixs:datatype="form-data" name="Enquiry from">
      <bpmn2:documentation id="documentation_fiIdcg"><![CDATA[<?xml version="1.0"?>
<imixs-form>
<imixs-form-section label="orderenquiry" columns="2">
     <item name="customer"      type="text"  readonly="false"  label="Customer:" span="12" />   
     <item name="customer.zip"  type="text"        label="ZIP:"        required="true"        readonly="false" span="2" />
     <item name="customer.city" type="text"       label="City:"       required="true"        readonly="false" span="4" />
     <item name="customer.country" type="custom"  path="country"      required="true"        readonly="false" label="Membership Country:" span="6"/>
     
      <item name="request.description" type="textarea"  label="Query:" span="12" /> 
      <item name="product.name" type="selectOneMenu"     label="Product Name :"   span="6"
       options = "Iron; Aluminium;Steel" required="true"/>
      <item name="quantity.number" type="text"     label="Quantity :" required="true" span="6" />
      <item name="delivery.date" type="date"     label="Expected delivery date :" required="true" span="6" />
      <item name="customer.comment"  type="text" label="Comment:"   />
</imixs-form-section>


<imixs-form-section>
         <item type="custom"
          path="spaceref"
          label="Department:" />
</imixs-form-section>

  <imixs-form-section columns="1" label="AI Assistant" readonly="true">
    <item name="order.summary" type="custom" path="markdown" label="Zusammenfassung" />
  </imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
