    <bpmn2:dataObject id="dataObject_fV6H2w" imixs:datatype="form-data" name="Customer Data">
      <bpmn2:documentation id="documentation_gnvAHg"><![CDATA[<?xml version="1.0"?>
<imixs-form>
<imixs-form-section label="orderenquiry" columns="2">
      <item name="company.name" type="text"  label="Company name:" required="true" />
      <item name="customer.firstname" type="text"  label="Firstname:" />
      <item name="customer.lastname"  type="text"  label="Lastname:" />
      <item name="customer.office"    type="text"  label="Telephone:" />
      <item name="customer.mobile"    type="text"  label="Mobile:" />
      <item name="customer.email"     type="text"  label="E-Mail:" />
      <item name="customer.vatid"     type="text"   label="VAT ID:" required="true"/>
</imixs-form-section>

<imixs-form-section label="Adress :" >
     <item name="customer.zip" type="text"     label="ZIP:" required="true" span="2" />
     <item name="customer.city" type="text"     label="City:" required="true" span="6" />
     <item name="customer.country" type="custom"  path="country" required="true"   label="Membership Country:" />
</imixs-form-section>

<imixs-form-section>
         <item type="custom"
          path="spaceref"
          label="Department:" />
</imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
