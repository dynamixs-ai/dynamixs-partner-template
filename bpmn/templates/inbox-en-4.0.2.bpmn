  <bpmn2:signal id="Signal_1" name="org.imixs.workflow.documents.OCRDocumentAdapter"/>
  <bpmn2:collaboration id="Collaboration_1" name="Default Collaboration">
    <bpmn2:participant id="Participant_1" name="Document Import" processRef="Process_1">
      <bpmn2:documentation id="documentation_m9vQ5g"><![CDATA[The system utilizes OCR to analyze incoming documents and emails, automatically detecting their document type and language. Once analyzed, the docuent undergoes classification to determine its core intent. Finally, the document is dynamically routed to the appropriate operational workflow (e.g Support, Sales, Finance, or Legal) for further processing.]]></bpmn2:documentation>
    </bpmn2:participant>
    <bpmn2:participant id="participant_GUMWGQ" name="Default Process" processRef="process_2"/>
  </bpmn2:collaboration>
