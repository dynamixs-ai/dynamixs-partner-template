      <bpmn2:documentation id="documentation_qm5IGg"><![CDATA[Email from <itemvalue>document.sender</itemvalue> in language <itemvalue>document.language</itemvalue> and type <itemvalue>document.type</itemvalue> is classified. It is automatically routed to its appropiate workflow.]]></bpmn2:documentation>
      <bpmn2:incoming>sequenceFlow_0tXCag</bpmn2:incoming>
      <bpmn2:outgoing>sequenceFlow_LZX10Q</bpmn2:outgoing>
