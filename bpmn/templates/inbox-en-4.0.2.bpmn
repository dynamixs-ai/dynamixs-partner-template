  </bpmn2:process>
  <bpmn2:process id="process_2" name="Imixs AI" processType="Public">
    <bpmn2:documentation id="documentation_dDLFbw"><![CDATA[The system utilizes OCR to analyze incoming emails, automatically detecting their document type and language. Once analyzed, the email undergoes classification to determine its core intent. Finally, the email is dynamically routed to the appropriate operational workflow (Support, Sales, Finance, or Legal) for processing.]]></bpmn2:documentation>
    <bpmn2:extensionElements>
      <open-bpmn:auto-align>true</open-bpmn:auto-align>
    </bpmn2:extensionElements>
  </bpmn2:process>
