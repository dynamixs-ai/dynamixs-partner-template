    <bpmn2:dataObject id="dataObject_w70wjQ" imixs:datatype="form-data" name="Fine Details">
      <bpmn2:documentation id="documentation_0C48RQ"><![CDATA[<?xml version="1.0"?>
<imixs-form>
  <imixs-form-section columns="1" label="Fine Summary" readonly="true" >
    <item name="fine.summary" type="custom" path="markdown" />
  </imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
    </bpmn2:dataObject>
    <bpmn2:association id="association_4ujFLw" sourceRef="dataObject_w70wjQ" targetRef="task_sPVESg">
      <bpmn2:documentation id="documentation_bu7glw"/>
