        <imixs:item name="rtfmailbody" type="xs:string">
          <imixs:value><![CDATA[Hallo,

I request you to please cancel my penalty charge due to mismatch in data and I also request you to pause the increase charge till the review is completed.

Regards]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtactivityresult" type="xs:string">
          <imixs:value><![CDATA[The driver with <itemvalue>fine.id</itemvalue> <itemvalue>fine.category.name</itemvalue> rejects the vioaltion.]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtbusinessrule" type="xs:string">
          <imixs:value><![CDATA[var result={};
result.isValid=true;

if ( workitem.getItemValueString('comment.user')==='' ) {
     result.isValid=false;
     result.errorMessage='Please enter the reason into the comment box. ';
}]]></imixs:value>
        </imixs:item>
