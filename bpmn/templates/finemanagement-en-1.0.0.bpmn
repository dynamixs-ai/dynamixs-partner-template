    <bpmn2:task id="task_aVcuoA" imixs:processid="1960" name="Generate mahnung">
      <bpmn2:extensionElements>
        <imixs:item name="txtworkflowsummary" type="xs:string">
          <imixs:value><![CDATA[<itemvalue>fine.id.name</itemvalue> <itemvalue>fine.category.name</itemvalue><itemvalue>plate.number</itemvalue>]]></imixs:value>
        </imixs:item>
