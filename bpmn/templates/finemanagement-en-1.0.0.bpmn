    <bpmn2:intermediateCatchEvent id="event_FJQ9QQ" imixs:activityid="250" name="Generate Payment remainder">
      <bpmn2:extensionElements>
        <imixs:item name="keypublicresult" type="xs:string">
          <imixs:value><![CDATA[1]]></imixs:value>
        </imixs:item>
        <imixs:item name="rtfmailbody" type="xs:string">
          <imixs:value><![CDATA[Hallo,

Enclosed please find a traffic violation notice for your CCA/CCB/CCS/rental vehicle.
Please respond to this letter immediately, otherwise considerable additional work and costs will be incurred.
You have not paid by the deadline. An additional fee has been added. Please pay with in 7 days.
Since you exceeded your due date you need to pay 100 euros.

Best regards.

]]></imixs:value>
        </imixs:item>
        <imixs:item name="nammailreceiver" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceivercc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceiverbcc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="txtmailsubject" type="xs:string">
          <imixs:value><![CDATA[Traffic Fine management to <itemvalue>plate.number</itemvalue>]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtbusinessrule" type="xs:string">
          <imixs:value><![CDATA[fine]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_5MwZhg"><![CDATA[New fine with additional charges occured because of crossing due date is generated.]]></bpmn2:documentation>
      <bpmn2:messageEventDefinition id="messageEventDefinition_kBZ00A" messageRef="message_1"/>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:dataObject id="dataObject_oPQBIw" imixs:datatype="form-data" name="Attachment">
      <bpmn2:documentation id="documentation_cn4PKQ"><![CDATA[<?xml version="1.0"?>
<imixs-form>

       <imixs-form-section label="Fine details" columns="2" readonly="true"> 
        <item name="driver.name" type="text" label="Name:" />
        <item name="Rent.date" type="date" label="From Date:" span="6" />
        <item name="Rent.enddate" type="date" label="To Date:" span="6" />
        <item name="fine.id" type="text" label="Fine ID:" required="true" />
        <item name="vehicle.name" type="text" label="Vehiclename:" />
        <item name="plate.number" type="text" label="Vehicle Number:" required="true" /> 
    </imixs-form-section>

    <imixs-form-section label="Violation details">

        <item name="fine.category.name" type="selectOneMenu" label="Violation Category  :"
            options="Overspeed;illegalparking;tailgating;Overtaking" required="true" />
        <item name="fine.location.country" type="custom" path="country" required="true"
            label="Country:" />
        <item name="fine.violation.date" type="html5datetime" label="Violation date/Time" />
        <item name="fine.location.description" type="textarea" label="Location:" />
    </imixs-form-section>

    <imixs-form-section label="Payment" readonly="true">
        <item name="payment.amount" type="currency" label="Amount:" />
        <item name="payment.currency" type="selectOneMenu"
            label="Currency:"
            options="EUR;CHF;SEK;NOK;GBP;USD" />
        <item name="payament.Bank.name" type="text" label="Bank Name: " />
        <item name="dbtr.iban" type="iban" label="IBAN"  />
        <item name="dbtr.bic" type="bic" label="BIC/SWIFT" />
        <item name="payament.Account.number" type="text" label="Account Number: "  />
        <item name="Payment.duedate.enddate" type="date" label="Due Date:" required="true" span="6" />
    </imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
    </bpmn2:dataObject>
