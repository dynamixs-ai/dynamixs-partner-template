    <bpmn2:dataObject id="dataObject_eaM6iQ" imixs:datatype="form-data" name="Deliverynote">
      <bpmn2:documentation id="documentation_CqGDCw"><![CDATA[<?xml version="1.0"?>
<imixs-form>
<imixs-form-section label="orderenquiry" columns="2">
      <item name="customer.ref"
      type="custom"
      path="workitemlink"
      readonly="false"
      options="$workflowgroup:Customer"
      label="Customer:" />    

     <item name="customer.zip" type="text"        label="ZIP:"        required="true"        readonly="false" span="2" />
     <item name="customer.city" type="text"       label="City:"       required="true"        readonly="false" span="6" />
     <item name="customer.country" type="custom"  path="country"      required="true"        readonly="false" label="Membership Country:" />
     <item name="request.description" type="textarea"  label="Query:" /> 
      <item name="product.name" type="selectOneMenu"     label="Product Name :" 
       options = "Iron; Aluminium;Steel" required="true"/>
      <item name="quantity.number" type="text"     label="Quantity :" required="true" span="6" />
      <item name="delivery.date" type="date"     label="Expected delivery date :" required="true" span="6" />
      <item name="customer.comment"  type="text" label="Comment:"   />
</imixs-form-section>
<imixs-form-section>
      <item name="itemsname" type="text"  label="Items Packed" />
</imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
