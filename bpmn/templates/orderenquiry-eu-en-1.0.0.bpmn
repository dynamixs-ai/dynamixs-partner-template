          <imixs:value><![CDATA[1]]></imixs:value>
        </imixs:item>
        <imixs:item name="keypublicresult" type="xs:string">
          <imixs:value><![CDATA[1]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_QdaH4Q"><![CDATA[Sends email to Customer stating that the item is not available at moment.]]></bpmn2:documentation>
