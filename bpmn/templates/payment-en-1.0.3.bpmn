  <bpmn2:collaboration id="collaboration_1" name="Default Collaboration">
    <bpmn2:participant id="participant_i00umQ" name="Default Process" processRef="process_1"/>
    <bpmn2:participant id="participant_b0ZB6w" name="Payment" processRef="process_W6vEog">
      <bpmn2:documentation id="documentation_MwcHNw"><![CDATA[This Payment workflow is to validate the fine repayments submitted by drivers via email in response to traffic violations. The system extracts the transaction details from the incoming email to match the payment against the validated rental contract and violation records.

This workflow is used as subworkflow in the finemanagement workflow.]]></bpmn2:documentation>
    </bpmn2:participant>
  </bpmn2:collaboration>
  <bpmn2:process definitionalCollaborationRef="collaboration_1" id="process_1" name="Default Process" processType="Public">
    <bpmn2:documentation id="documentation_0tkjlg"><![CDATA[This is the Payment sub-workflow used to validate the fine repayments submitted by drivers via email in response to traffic violations. The system extracts the transaction details from the incoming email to match the payment against the validated rental contract and violation records.

]]></bpmn2:documentation>
    <bpmn2:extensionElements>
      <open-bpmn:auto-align>true</open-bpmn:auto-align>
    </bpmn2:extensionElements>
  </bpmn2:process>
