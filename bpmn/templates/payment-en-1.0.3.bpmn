    <bpmn2:intermediateCatchEvent id="event_rXriJA" imixs:activityid="150" name="Email notification">
      <bpmn2:extensionElements>
        <imixs:item name="rtfresultlog" type="xs:string">
          <imixs:value><![CDATA[Email sent to driver about failed payment and requested him to clear the fine asap. The case is still open.]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtmailsubject" type="xs:string">
          <imixs:value><![CDATA[Payment Incompleted with reference to <itemvalue>fine.id</itemvalue>  <itemvalue>plate.number</itemvalue>]]></imixs:value>
        </imixs:item>
        <imixs:item name="nammailreceiver" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceivercc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceiverbcc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="rtfmailbody" type="xs:string">
          <imixs:value><![CDATA[
Dear Driver,

Thank you for your patience while we processed your recent account review or dispute submission. Our team has completed the investigation into your file. Based on our review of the records, we have identified an outstanding discrepancy or non-compliance issue that requires your immediate attention and financial rectification.Please be patient while our administration team finalizes your file details. We will get back to you within [3 to 5] business days with the formal breakdown, the exact amount required for repayment, and secure instructions on how to settle the balance.If you have already made a payment regarding this matter, or if you have additional supporting documents to upload, please reply directly to this email.Thank you for your prompt cooperation in bringing your account back into alignment.

With best regards.]]></imixs:value>
        </imixs:item>
        <imixs:item name="keypublicresult" type="xs:string">
          <imixs:value><![CDATA[1]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_i8qubw"><![CDATA[An Email has been sent to driver stating that payment is pending and case in hold and is still active.]]></bpmn2:documentation>
      <bpmn2:outgoing>sequenceFlow_Pl6iSQ</bpmn2:outgoing>
      <bpmn2:messageEventDefinition id="messageEventDefinition_Roc0bQ" messageRef="message_1"/>
      <bpmn2:incoming>sequenceFlow_DR8xfQ</bpmn2:incoming>
    </bpmn2:intermediateCatchEvent>
