      <bpmn2:documentation id="documentation_bFAOXQ"><![CDATA[<?xml version="1.0"?>
<imixs-form>
  <imixs-form-section label="AI Assistant" path="ai/agent_status" />
    <imixs-form-section label="Payement Data" columns="3">   
    <item name="id" type="text" label="Payment Reference:" />
    <item name="transferred.payment.type" type="selectOneMenu"     label="Payment Type:" 
       options = "EC; VISA; PayPal" required="false"/>
    <item name="transferred.payment.amount" type="currency" label="Payment Amount:" />
    <item name="transferred.payment.currency" type="selectOneMenu"
            label="Currency:"
            options="EUR;CHF;SEK;NOK;GBP;USD" />
    <item name="transferred.payment.dbtr.iban" type="iban" label="IBAN" />
    <item name="transferred.payment.dbtr.bic" type="bic" label="BIC/SWIFT" />
  </imixs-form-section>

  <imixs-form-section label="Payement Data" columns="1">  
    <item name="fine.ref"
        type="custom"
        path="workitemlink"
        readonly="false"
        options="$workflowgroup:Fine Management"
        label="Fine Details:" />   
      <item name="fine.id"    type="text"  label="Fine ID:" span="4" />
      <item name="contract.customer.firstname" type="text"  label="Firstname:" />
      <item name="contract.customer.lastname"  type="text"  label="Lastname:" />
      <item name="contract.customer.email"  type="text"    label="Email:"  />
      <item name="transferred.payment.bank.name" type="text" label="Bank Name:" />
      <item name="transferred.payment.account.number" type="text" label="Account Number" />   
  </imixs-form-section>
  <imixs-form-section columns="1" label="Payment Summary" readonly="true">
    <item name="payment.summary" type="custom" path="markdown" />
  </imixs-form-section>
</imixs-form>

 ]]></bpmn2:documentation>
