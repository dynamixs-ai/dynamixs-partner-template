    <bpmn2:participant id="participant_b0ZB6w" name="Payment" processRef="process_W6vEog">
      <bpmn2:documentation id="documentation_MwcHNw"><![CDATA[A Payment workflow is to validate payment transactions submitted by customers or drivers. For example a payment response to traffic violations. 
A payment document shows typically a bank account (e.g. IBAN / BIC) , the ammount of payment and a reference number to assign the payment to an outstanding invoice (e.g. a fine) 
]]></bpmn2:documentation>
    </bpmn2:participant>
  </bpmn2:collaboration>
