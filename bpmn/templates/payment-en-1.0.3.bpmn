      <bpmn2:messageEventDefinition id="messageEventDefinition_VXuujw" messageRef="message_1"/>
      <bpmn2:incoming>sequenceFlow_ixy9qQ</bpmn2:incoming>
    </bpmn2:intermediateCatchEvent>
