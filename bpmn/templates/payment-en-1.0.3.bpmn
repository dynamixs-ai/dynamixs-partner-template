      <bpmn2:documentation id="documentation_xwDG0Q"><![CDATA[Driver accepts violation and transfers the amount.
Payment process is successful for the driver with Vehicle Number: <itemvalue>fine.plate.number</itemvalue>. Case with Fine Id <itemvalue>fine.id</itemvalue> is closed.]]></bpmn2:documentation>
      <bpmn2:outgoing>sequenceFlow_sgjE2A</bpmn2:outgoing>
      <bpmn2:incoming>sequenceFlow_mg0Lqg</bpmn2:incoming>
    </bpmn2:task>
    <bpmn2:intermediateCatchEvent id="event_6df4bw" imixs:activityid="150" name="Email notification">
      <bpmn2:extensionElements>
        <imixs:item name="rtfresultlog" type="xs:string">
          <imixs:value><![CDATA[Email sent to customer about successful payment. ]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtmailsubject" type="xs:string">
          <imixs:value><![CDATA[Paymnet sucessful-Account Updation with reference to <itemvalue>fine.id</itemvalue>  <itemvalue>plate.number</itemvalue>]]></imixs:value>
        </imixs:item>
        <imixs:item name="nammailreceiver" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceivercc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="nammailreceiverbcc" type="xs:string">
          <imixs:value/>
        </imixs:item>
        <imixs:item name="rtfmailbody" type="xs:string">
          <imixs:value><![CDATA[Dear Driver,

Thank you for your payment. This email confirms that we have successfully received and processed your recent transaction.This payment fully settles the outstanding balance regarding your:Payment. Our system has been updated, and your account is now back in good standing regarding this specific matter. No further action is required from your side.You can view your updated balance and download your official payment receipt by logging into your bank account at any time.Thank you for your prompt cooperation in resolving this case.

With best regards.]]></imixs:value>
        </imixs:item>
        <imixs:item name="keypublicresult" type="xs:string">
          <imixs:value><![CDATA[1]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_zG03tQ"><![CDATA[An Email has been sent to customer about the successful payment.]]></bpmn2:documentation>
