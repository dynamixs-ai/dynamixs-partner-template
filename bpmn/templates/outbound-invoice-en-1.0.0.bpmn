    <bpmn2:dataObject id="dataObject_yz8oeg" imixs:datatype="form-data" name="Enquiry form">
      <bpmn2:documentation id="documentation_fiIdcg"><![CDATA[<?xml version="1.0"?>
<imixs-form>
<imixs-form-section  label="Offer Details:" columns="3">   

     <item name="contact.name" type="text"     label="Contact Name:" span="6" />
     <item name="customer.name" type="text"   label="Customer Name" />
     <item name="customer.id" type="text"   label="Customer ID" />
      <item name="product.name" type="selectOneMenu"     label="Product Name :" 
       options = "Iron; Aluminium;Steel" />
      <item name="quantity.number" type="text"     label="Quantity :" span="6" />
</imixs-form-section>

<imixs-form-section label="Billing details: " columns="2">
      <item name="payment.terms" type="text" label="Payment Terms: " span="6" />
      <item name="offer.validity" type="text" label="Offer Validity: " span="6" />
      <item name="pricing.actual" type="text" label="Sub Total:" span="6" />
      <item name="tax.charges" type="text" label="Tax 19,00%: " span="6" />
      <item name="pricing.total" type="text" label="Total Price: " span="6" />
      <item name="payment.currency" type="selectOneMenu"
            label="Currency:"
            options="EUR;CHF;SEK;NOK;GBP;USD" span="4" />
      <item name="payment.bank.name" type="text" label="Bank Name: " span="6"/>
      <item name="payment.account.number" type="text" label="Account Number: " span="4"/>
      <item name="payment.reference" type="text" label="Payment Reference: " />
      <item name="payment.dbtr.iban" type="iban" label="IBAN" span="4"/>
      <item name="payment.dbtr.bic" type="bic" label="BIC/SWIFT" span="4"/> 
      <item name="payment.duedate" type="date" label="Due Date:" span="6" />

</imixs-form-section>
      
   


<imixs-form-section>
         <item type="custom"
          path="spaceref"
          label="Department:" />
</imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
    </bpmn2:dataObject>
