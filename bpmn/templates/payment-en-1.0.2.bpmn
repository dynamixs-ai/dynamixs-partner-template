      <item name="payment.account.number" type="text" label="Account Number" />
      <item name="payment.reference" type="text" label="Payment Reference:" />
      <item name="payment.type" type="selectOneMenu"     label="Payment Type:" 
       options = "EC; VISA; PayPal" required="false"/>
      <item name="payment.amount" type="currency" label="Amount:" />
      <item name="payment.currency" type="selectOneMenu"
            label="Currency:"
            options="EUR;CHF;SEK;NOK;GBP;USD" />
      <item name="payment.dbtr.iban" type="iban" label="IBAN" />
      <item name="payment.dbtr.bic" type="bic" label="BIC/SWIFT" /> 
</imixs-form-section>
 <imixs-form-section columns="1" label="Payment Summary" readonly="true" >
      <item name="payment.summary" type="custom" path="markdown" />
</imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
