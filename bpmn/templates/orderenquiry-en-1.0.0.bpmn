    <bpmn2:dataObject id="dataObject_jGwopw" imixs:datatype="form-data" name="Enquiry from">
      <bpmn2:documentation id="documentation_fiIdcg"><![CDATA[<?xml version="1.0"?>
<imixs-form>
<imixs-form-section label="orderenquiry" columns="2">
      <item name="request.name" type="text"  label="Company name:" required="true" />
      <item name="request.description" type="textarea"  label="Query:" /> 
      <item name="customer.firstname" type="text"  label="Firstname:" />
      <item name="customer.lastname" type="text"  label="Lastname:" />
      <item name="customer.office" type="text"  label="Telephone:" />
      <item name="customer.mobile" type="text"  label="Mobile:" />
      <item name="customer.email" type="text"  label="E-Mail:" />
      <item name="product.name" type="selectOneMenu"     label="Product Name :" 
       options = "Iron; Aluminium;Steel" required="true"/>
      <item name="quantity.number" type="text"     label="Quantity :" required="true" span="6" />
      <item name="delivery.date" type="date"     label="Expected delivery date :" required="true" span="6" />
 <item name="customer.comment"  type="text" label="Comment:"   />
</imixs-form-section>

<imixs-form-section label="Adress :" >
     <item name="customer.zip" type="text"     label="ZIP:" required="true" span="2" />
     <item name="customer.city" type="text"     label="City:" required="true" span="6" />
     <item name="customer.country" type="text"     label="Country:" required="true" span="6" />
</imixs-form-section>

<imixs-form-section>
         <item type="custom"
          path="spaceref"
          label="Department:" />
</imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
    </bpmn2:dataObject>
