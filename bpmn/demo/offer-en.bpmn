      <bpmn2:documentation id="Documentation_8"><![CDATA[<?xml version="1.0"?>
<imixs-form>

  
  <imixs-form-section columns="2" label="Offer Data" readonly="false">
   <item name="customer.ref" 
      type="custom"  required="false"
      path="workitemlink"
      options="($workflowgroup:Customer)((type:workitem) OR (type:workitemarchive))"
      label="Customer:" />
   <item name="product.ref" 
      type="custom"  required="false"
      path="workitemlink"
      options="($workflowgroup:Product)((type:workitem) OR (type:workitemarchive))"
      label="Products:" />

  </imixs-form-section>

  <imixs-form-section columns="3" label="Offer Proposal:" readonly="false" >
    <item name="offer.date" type="date" label="Date:" />
    <item name="offer.due" type="date" label="Due Date:" />
  </imixs-form-section>
  <imixs-form-section columns="1" label="" readonly="false" >
    <item name="offer.proposal" type="custom" path="markdowneditor" />
  </imixs-form-section>

</imixs-form>]]></bpmn2:documentation>
