Violation Date:<itemvalue>fine.violation.date</itemvalue>]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
      <bpmn2:documentation id="documentation_CaGU2g"><![CDATA[Please use your number plate and fine id as Reference number when your are transferring the amount.]]></bpmn2:documentation>
