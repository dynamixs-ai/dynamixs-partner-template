    <bpmn2:sequenceFlow id="sequenceFlow_UAvq3A" sourceRef="gateway_m1kdyA" targetRef="task_K8UMzg">
      <bpmn2:documentation id="documentation_7LS3AA"/>
      <bpmn2:conditionExpression id="formalExpression_lT998w" xsi:type="bpmn2:tFormalExpression"><![CDATA[var plateContract=workitem.getItemValueString("contract.plate.number");
var plateFine=workitem.getItemValueString("fine.plate.number");


plateContract=plateContract.replace(' ','');
plateContract=plateContract.replace('-','');

plateFine=plateFine.replace(' ','');
plateFine=plateFine.replace('-','');


plateContract!=plateFine;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
