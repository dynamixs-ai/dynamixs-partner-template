    <bpmn2:exclusiveGateway default="sequenceFlow_k1tb2w" gatewayDirection="Diverging" id="gateway_m1kdyA" name="">
      <bpmn2:documentation id="documentation_YdjGDA"/>
      <bpmn2:incoming>sequenceFlow_rxecWQ</bpmn2:incoming>
      <bpmn2:outgoing>sequenceFlow_UAvq3A</bpmn2:outgoing>
