    <bpmn2:dataObject id="dataObject_fV6H2w" imixs:datatype="form-data" name="Contract Data">
      <bpmn2:documentation id="documentation_gnvAHg"><![CDATA[<?xml version="1.0"?>
<imixs-form>
<imixs-form-section label="Contract details: " columns="2">
     <item name="contract.type" type="selectOneMenu"     label="Contract Type:" 
       options = "Internal Rent; External Rent;Purchase;Sales;Insurance;Lease" required="true"/>
      <item name="contract.id"    type="text"  label="Contract ID:" />
      <item name="contract.customer.firstname" type="text"  label="Firstname:" />
      <item name="contract.customer.lastname"  type="text"  label="Lastname:" />
      <item name="contract.customer.email"  type="text"    label="Email:"  />
      <item name="contract.vehicle.name" type="text" label="Vehicle name:" />
      <item name="contract.plate.number" type="text" label="Vehicle Number:" />      
</imixs-form-section>

<imixs-form-section label="Rental details:" >
     <item name="contract.customer.zip" type="text"     label="ZIP:" />
     <item name="contract.customer.city" type="text"     label="City:" />
     <item name="contract.customer.country" type="custom"  path="country"  label="Membership Country:" />
     <item name="contract.start.date" type="date" label="Start date" />
     <item name="contract.end.date" type="date" label="End date" />
</imixs-form-section>

<imixs-form-section label="Payment details:" >
     <item name="contract.payment.amount" type="currency" label="Amount:" />
     <item name="contract.payment.bank.name" type="text" label="Bank Name:" />
     <item name="contract.payment.iban" type="text" label="IBAN:" />
     <item name="contract.payment.bic" type="text" label="BIC:" />
     <item name="contract.payment.account.number" type="text" label="Account Number:" />
     <item name="contract.payment.currency" type="selectOneMenu"
            label="Currency:"
            options="EUR;CHF;SEK;NOK;GBP;USD" />
     <item name="contract.deposit.amount" type="currency" label="Deposit Amount:" />
</imixs-form-section>
</imixs-form>]]></bpmn2:documentation>
