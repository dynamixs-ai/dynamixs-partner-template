    <bpmn2:intermediateCatchEvent id="event_b740TQ" imixs:activityid="10" name="Resubmission request">
      <bpmn2:extensionElements>
        <imixs:item name="rtfresultlog" type="xs:string">
          <imixs:value><![CDATA[In complete data is detected in validation check.]]></imixs:value>
        </imixs:item>
        <imixs:item name="nammailreceiver" type="xs:string">
          <imixs:value/>
        </imixs:item>
