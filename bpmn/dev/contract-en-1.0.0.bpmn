          <imixs:value/>
        </imixs:item>
        <imixs:item name="rtfmailbody" type="xs:string">
          <imixs:value><![CDATA[Hallo, 

thanks for contacting us. We cant go forward with your enquiry due to missing manadatory data. Hence we request you to please fill required data and resubmit the request. 











]]></imixs:value>
        </imixs:item>
        <imixs:item name="txtmailsubject" type="xs:string">
          <imixs:value><![CDATA[Automatic reply]]></imixs:value>
        </imixs:item>
      </bpmn2:extensionElements>
