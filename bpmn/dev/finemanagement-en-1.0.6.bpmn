    <bpmn2:dataObject id="dataObject_Wsh20Q" imixs:datatype="form-data" name="Fine Details">
      <bpmn2:documentation id="documentation_x8YIfw"><![CDATA[<?xml version="1.0"?>
<imixs-form>
<imixs-form-section label="Contract details: " columns="2">

      <item name="contract.ref"
        type="custom"
        path="workitemlink"
        readonly="false"
        options="$workflowgroup:Contract"
        label="Contract Details:" />
      </imixs-form-section>
 
<imixs-form-section label="Fine details: " columns="2">
        <item name="fine.id" type="text" label="Fine ID:" required="true" span="4"/>
        <item name="fine.vehicle.name" type="text" label="Vehiclename:" span="4"/>
        <item name="fine.plate.number" type="text" label="Vehicle Number:" />
</imixs-form-section>

<imixs-form-section label="Violation details:" columns="2">

         <item name="fine.category.name" type="text" label="Violation Category:" />
        <item name="fine.location.country" type="custom" path="country"  label="Country:" span="4"/>
        <item name="fine.violation.date" type="html5datetime" label="Violation date/Time" span="4"/>
        <item name="fine.location.description" type="textarea" label="Location:" />
 </imixs-form-section>

<imixs-form-section label="Payment details: " columns="2">
        <item name="payment.amount" type="currency" label="Amount:" span="4"/>
        <item name="payment.currency" type="selectOneMenu"
            label="Currency:"
            options="EUR;CHF;SEK;NOK;GBP;USD" span="4"/>
        <item name="payment.bank.name" type="text" label="Bank Name: " span="6"/>
        <item name="payment.account.number" type="text" label="Account Number: " span="4"/>
        <item name="payment.reference" type="text" label="Payment Reference: " />
        <item name="payment.dbtr.iban" type="iban" label="IBAN" span="4"/>
        <item name="payment.dbtr.bic" type="bic" label="BIC/SWIFT" span="4"/> 
        <item name="payment.duedate" type="date" label="Due Date:" span="6" />
</imixs-form-section>
<imixs-form-section columns="1" label="Fine Summary" readonly="true" >
      <item name="fine.summary" type="custom" path="markdown" />
</imixs-form-section>

</imixs-form>]]></bpmn2:documentation>
