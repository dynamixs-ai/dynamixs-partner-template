        <imixs:item name="txtworkflowabstract" type="xs:string">
          <imixs:value><![CDATA[Fine Details:
Fine Id : <itemvalue>fine.id</itemvalue>

Vehicle Details:
Vehicle Plate Number :<itemvalue>fine.plate.number</itemvalue>,
Vehicle Name: <itemvalue>fine.vehicle.name</itemvalue>

Payment Details:
Reference number: <itemvalue>payment.reference</itemvalue>]]></imixs:value>
        </imixs:item>
