  <bpmn2:collaboration id="collaboration_1" name="Default Collaboration">
    <bpmn2:participant id="participant_f0g5Ug" name="Default Process" processRef="process_1"/>
    <bpmn2:participant id="participant_Z8irtw" name="Fine Management" processRef="process_trU6HQ">
      <bpmn2:documentation id="documentation_tS0RdQ"><![CDATA[This is the fine management work flow which validates the traffic violations assigned by traffic authorities. The system cross-references the vehicle's number plate from the violation notice with active rental contracts to accurately identify the responsible driver.
This work flow is linked with contract workflow to identify the vehicle owner by validating the Rental acontracts and this workflow also contains payment sub work flow for completing payment process.]]></bpmn2:documentation>
      <bpmn2:incoming>association_y1ur0g</bpmn2:incoming>
    </bpmn2:participant>
  </bpmn2:collaboration>
  <bpmn2:process definitionalCollaborationRef="collaboration_1" id="process_1" name="Default Process" processType="Public">
